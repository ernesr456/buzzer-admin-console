{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/buzzer-admin-console",
  "functions": {
    "dist/buzzer-admin-console/server/server.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/_next/static/(.*)", "dest": "/_next/static/$1" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "dist/buzzer-admin-console/server/server.js" }
  ]
}